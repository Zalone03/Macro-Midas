<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Botão principal: dourado em baixa opacidade, texto claro, borda fina -->
  <ControlTheme x:Key="GoldButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource GoldGradient}" />
    <Setter Property="Foreground" Value="{StaticResource GoldInkBrush}" />
    <Setter Property="BorderBrush" Value="#3DC9A75E" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{StaticResource GoldGradientHover}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <!-- Confirmação perigosa (apagar, limpar): vermelho fraco -->
  <ControlTheme x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GoldButton}">
    <Setter Property="Background" Value="#26C77272" />
    <Setter Property="BorderBrush" Value="#4DC77272" />
    <Setter Property="Foreground" Value="#E8B4B4" />
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="#38C77272" />
    </Style>
  </ControlTheme>

  <!-- "Mais opções": texto discreto com seta que gira -->
  <ControlTheme x:Key="MoreToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Name="PART_Chevron" Data="M0,0 L4,4 L0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                  StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" Width="5" Height="9"
                  RenderTransformOrigin="50%,50%" RenderTransform="rotate(0deg)">
              <Path.Transitions>
                <Transitions>
                  <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
              </Path.Transitions>
            </Path>
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    </Style>
    <Style Selector="^:checked /template/ Path#PART_Chevron">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
  </ControlTheme>

  <!-- Botão discreto (texto/ícone, fundo aparece no hover) -->
  <ControlTheme x:Key="GhostButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.15" />
              <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="^.active">
      <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
    </Style>
    <Style Selector="^.active /template/ Border#PART_Border">
      <Setter Property="Background" Value="{StaticResource GoldSoftBrush}" />
    </Style>
    <Style Selector="^.danger:pointerover">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="^.danger:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
    </Style>
    <Style Selector="^.outline /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{StaticResource Bg5Brush}" />
    </Style>
    <Style Selector="^.outline:pointerover /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="#88F5B82E" />
    </Style>
  </ControlTheme>

  <!-- Botão quadrado só com ícone -->
  <ControlTheme x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </ControlTheme>

  <!-- Botão-alternância só com ícone -->
  <ControlTheme x:Key="IconToggle" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="#1AFFFFFF" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
    </Style>
  </ControlTheme>

  <!-- Segmento de um controle segmentado (RadioButton) -->
  <ControlTheme x:Key="SegmentRadio" TargetType="RadioButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.18" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="#14FFFFFF" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Border">
      <Setter Property="Background" Value="#24C9A75E" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
  </ControlTheme>

  <!-- Bloco da paleta de passos (ícone + nome) -->
  <ControlTheme x:Key="PaletteButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransform" Value="none" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
              <BrushTransition Property="Background" Duration="0:0:0.18" />
              <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="#99F5B82E" />
      <Setter Property="Background" Value="#24242A" />
      <Setter Property="BoxShadow" Value="0 6 18 0 #40000000" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
  </ControlTheme>

  <!-- "+ adicionar" dentro de blocos (discreto) -->
  <ControlTheme x:Key="AddHereButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </ControlTheme>

  <!-- "+ Adicionar passo" no fim da lista: linha inteira -->
  <ControlTheme x:Key="AddRowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="7" />
  </ControlTheme>
</ResourceDictionary>
