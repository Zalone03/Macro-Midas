<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:MacroMidas.Controls">

  <!-- Base -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Bg0Brush}" />
    <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
  </Style>
  <Style Selector="TextBlock.gold">
    <Setter Property="Foreground" Value="{StaticResource GoldTextGradient}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Campos do painel de propriedades: rótulo, controle e uma frase explicando -->
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
    <Setter Property="Margin" Value="0,0,0,7" />
  </Style>
  <Style Selector="TextBlock.fieldHelp">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>

  <!-- Entradas -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CaretBrush" Value="{StaticResource GoldBrightBrush}" />
  </Style>
  <Style Selector="TextBox.capturing">
    <Setter Property="BorderBrush" Value="{StaticResource GoldBrightBrush}" />
  </Style>
  <Style Selector="TextBox.capturing /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource GoldBrightBrush}" />
    <Setter Property="Background" Value="#1AF5B82E" />
  </Style>

  <!-- Nome do fluxo editável no cabeçalho: sem moldura até passar o mouse -->
  <Style Selector="TextBox.title /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.title:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#3A3A42" />
    <Setter Property="Background" Value="#0AFFFFFF" />
  </Style>
  <Style Selector="TextBox.title:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
    <Setter Property="Background" Value="#121215" />
  </Style>
  <Style Selector="TextBox Button.capture">
    <Setter Property="Theme" Value="{StaticResource IconButton}" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="0,0,3,0" />
  </Style>
  <Style Selector="TextBox.capturing Button.capture">
    <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
  </Style>

  <!-- Sem setas: mais compacto. Roda do mouse e ↑/↓ continuam ajustando o valor. -->
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ShowButtonSpinner" Value="False" />
    <Setter Property="MinWidth" Value="60" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox">
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
  </Style>

  <!-- Controle segmentado -->
  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="#121215" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Border.segmented RadioButton">
    <Setter Property="Theme" Value="{StaticResource SegmentRadio}" />
  </Style>

  <!-- Superfícies -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Bg2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource LineBrush}" />
  </Style>
  <Style Selector="Border.goldline">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource GoldLineGradient}" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource GoldSoftBrush}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="#202026" />
    <Setter Property="BorderBrush" Value="#3A3A42" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="6,1" />
  </Style>
  <Style Selector="Border.kbd TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
  </Style>

  <!-- Menu clássico na barra de título -->
  <Style Selector="Menu.appMenu">
    <Setter Property="Height" Value="26" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Menu.appMenu > MenuItem">
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="Height" Value="26" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
  </Style>
  <Style Selector="Menu.appMenu MenuItem MenuItem">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="12,5,14,5" />
  </Style>

  <Style Selector="ListBox.flows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.flows ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.flows ListBoxItem TextBlock.flowName">
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
  </Style>
  <Style Selector="ListBox.flows ListBoxItem:pointerover TextBlock.flowName">
    <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
  </Style>
  <Style Selector="ListBox.flows ListBoxItem:selected TextBlock.flowName">
    <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
  </Style>

  <!-- Abas de fluxo (faixa horizontal abaixo do menu) -->
  <Style Selector="ListBox.flowtabs">
    <Setter Property="Padding" Value="2,0" />
  </Style>
  <Style Selector="ListBox.flowtabs ListBoxItem">
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="Margin" Value="2,6" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.flowtabs ListBoxItem TextBlock.flowName">
    <Setter Property="Foreground" Value="{StaticResource Text2Brush}" />
  </Style>
  <Style Selector="ListBox.flowtabs ListBoxItem:pointerover">
    <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
  </Style>
  <Style Selector="ListBox.flowtabs ListBoxItem:selected">
    <Setter Property="Background" Value="#20C9A75E" />
  </Style>
  <Style Selector="ListBox.flowtabs ListBoxItem:selected TextBlock.flowName">
    <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
  </Style>

  <!-- Cartões de passo -->
  <Style Selector="Panel.appear">
    <Setter Property="RenderTransform">
      <TranslateTransform />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:0.26" Easing="CubicEaseOut" FillMode="None">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
          <Setter Property="TranslateTransform.Y" Value="8" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
          <Setter Property="TranslateTransform.Y" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Linha de passo: fina e sem moldura; o destaque aparece só no hover/seleção -->
  <Style Selector="Border.stepCard">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="0,0,6,0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.stepCard:pointerover">
    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
  </Style>
  <Style Selector="Border.stepCard.selected">
    <Setter Property="Background" Value="#16D9AE48" />
  </Style>
  <Style Selector="Border.stepCard.off">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Border.stepCard.dragging">
    <Setter Property="Opacity" Value="0.3" />
  </Style>
  <Style Selector="Border.stepCard.running">
    <Setter Property="Background" Value="#12D9AE48" />
  </Style>
  <Style Selector="Border.stepCard.running TextBlock.stepTitle">
    <Setter Property="Foreground" Value="{StaticResource GoldBrightBrush}" />
  </Style>

  <!-- Barrinha dourada à esquerda: seleção (fixa) e execução (pulsando) -->
  <Style Selector="Border.stepCard Border.selBar">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.stepCard.selected Border.selBar">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.stepCard.running Border.selBar">
    <Style.Animations>
      <Animation Duration="0:0:0.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.2" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Ações (⋯) só no hover/seleção -->
  <Style Selector="Border.stepCard StackPanel.stepActions">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.stepCard:pointerover StackPanel.stepActions, Border.stepCard.selected StackPanel.stepActions">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="TextBlock.stepIndex">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,10,0" />
  </Style>
  <Style Selector="TextBlock.stepTitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Text1Brush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.stepSummary">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.branchLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource Text3Brush}" />
    <Setter Property="Margin" Value="4,6,0,2" />
  </Style>
  <Style Selector="Border.branchLine">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="#2A2A30" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,2,9,10" />
  </Style>
  <!-- Coluna de uma trilha do bloco "Ao mesmo tempo" -->
  <Style Selector="Border.trackColumn">
    <Setter Property="BorderBrush" Value="#242429" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6,4,6,2" />
    <Setter Property="Background" Value="#0AFFFFFF" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Panel.blockOff">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Avisos -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="#F51A1A1D" />
    <Setter Property="BorderBrush" Value="#2C2C31" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
  </Style>
  <Style Selector="Border.toast c|Icon.toastIcon">
    <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
  </Style>
  <Style Selector="Border.toast.success c|Icon.toastIcon">
    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
  </Style>
  <Style Selector="Border.toast.warning c|Icon.toastIcon">
    <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
  </Style>
  <Style Selector="Border.toast.error">
    <Setter Property="BorderBrush" Value="#66E06060" />
  </Style>
  <Style Selector="Border.toast.error c|Icon.toastIcon">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>

  <!-- Diversos -->
  <Style Selector="ToolTip">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="c|Icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <Style Selector="Ellipse.pulseDot">
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0.25" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
